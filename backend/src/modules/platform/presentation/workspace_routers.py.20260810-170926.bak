@protected_router.post("/webhooks", response_model=CustomSuccessResponseSchema)
async def create_webhook(
    request: Request,
    body: WebhookCreateRequest,
    session: AsyncSessionDep,
):
    context = await load_workspace_context(request, session, {"owner", "admin"})
    secret = f"whsec_{secrets.token_urlsafe(32)}"
    item = WebhookEndpointModel(
        organization_id=context.organization.id,
        name=body.name.strip(),
        url=str(body.url),
        events=body.events,
        secret_encrypted=encrypt(secret),
    )
    session.add(item)
    await session.flush()
    await write_audit_log(
        session,
        request,
        action="workspace.webhook_created",
        resource_type="webhook_endpoint",
        resource_uuid=item.uuid,
        metadata={"url": item.url, "events": item.events},
        organization_id=context.organization.id,
    )
    await session.commit()
    return cr.success(
        data={
            "uuid": item.uuid,
            "name": item.name,
            "url": item.url,
            "events": item.events,
            "secret": secret,
        },
        message="Webhook created. Copy the signing secret now.",
    )


@protected_router.patch(
    "/webhooks/{webhook_uuid}", response_model=CustomSuccessResponseSchema
)
async def update_webhook(
    request: Request,
    webhook_uuid: str,
    body: WebhookUpdateRequest,
    session: AsyncSessionDep,
):
    context = await load_workspace_context(request, session, {"owner", "admin"})
    item = (
        (
            await session.execute(
                select(WebhookEndpointModel).where(
                    WebhookEndpointModel.uuid == webhook_uuid,
                    WebhookEndpointModel.organization_id == context.organization.id,
                )
            )
        )
        .scalars()
        .first()
    )
    if not item:
        raise NotFoundError(error="Webhook endpoint not found")
    values = body.model_dump(exclude_unset=True)
    if "url" in values and values["url"] is not None:
        values["url"] = str(values["url"])
    for key, value in values.items():
        setattr(item, key, value)
    item.updated_at = datetime.now(UTC)
    await write_audit_log(
        session,
        request,
        action="workspace.webhook_updated",
        resource_type="webhook_endpoint",
        resource_uuid=item.uuid,
        metadata={"fields": sorted(values)},
        organization_id=context.organization.id,
    )
    await session.commit()
    return cr.success(data={"uuid": item.uuid, **values}, message="Webhook updated")


@protected_router.delete(
    "/webhooks/{webhook_uuid}", response_model=CustomSuccessResponseSchema
)
async def delete_webhook(request: Request, webhook_uuid: str, session: AsyncSessionDep):
    context = await load_workspace_context(request, session, {"owner", "admin"})
    item = (
        (
            await session.execute(
                select(WebhookEndpointModel).where(
                    WebhookEndpointModel.uuid == webhook_uuid,
                    WebhookEndpointModel.organization_id == context.organization.id,
                )
            )
        )
        .scalars()
        .first()
    )
    if not item:
        raise NotFoundError(error="Webhook endpoint not found")
    await write_audit_log(
        session,
        request,
        action="workspace.webhook_deleted",
        resource_type="webhook_endpoint",
        resource_uuid=item.uuid,
        organization_id=context.organization.id,
    )
    await session.delete(item)
    await session.commit()
    return cr.success(data={"uuid": webhook_uuid}, message="Webhook deleted")


@protected_router.get("/audit-logs", response_model=CustomSuccessResponseSchema)
async def list_audit_logs(
    request: Request,
    session: AsyncSessionDep,
    search: str | None = Query(default=None),
    limit: int = Query(default=100, ge=1, le=200),
    offset: int = Query(default=0, ge=0),
):
    context = await load_workspace_context(request, session, {"owner", "admin"})
    filters = [AuditLogModel.organization_id == context.organization.id]
    if search:
        pattern = f"%{search.strip()}%"
        filters.append(
            or_(
                AuditLogModel.action.ilike(pattern),
                AuditLogModel.resource_type.ilike(pattern),
                AuditLogModel.resource_uuid.ilike(pattern),
            )
        )
    items = (
        await session.execute(
            select(AuditLogModel, UserModel.full_name, UserModel.email)
            .outerjoin(UserModel, UserModel.id == AuditLogModel.actor_user_id)
            .where(*filters)
            .order_by(AuditLogModel.created_at.desc())
            .limit(limit)
            .offset(offset)
        )
    ).all()
    org_activities = (
        (
            await session.execute(
                select(OrganizationActivityModel)
                .where(
                    OrganizationActivityModel.organization_id
                    == context.organization.id,
                    OrganizationActivityModel.deleted_at.is_(None),
                )
                .order_by(OrganizationActivityModel.created_at.desc())
                .limit(50)
            )
        )
        .scalars()
        .all()
    )
    payload = [
        {
            "uuid": log.uuid,
            "action": log.action,
            "resource_type": log.resource_type,
            "resource_uuid": log.resource_uuid,
            "metadata": log.metadata_,
            "ip_address": log.ip_address,
            "actor": {"name": actor_name, "email": actor_email},
            "created_at": log.created_at,
        }
        for log, actor_name, actor_email in items
    ]
    payload.extend(
        {
            "uuid": item.uuid,
            "action": item.activity_type,
            "resource_type": "organization_activity",
            "resource_uuid": None,
            "metadata": {"title": item.title, "target_email": item.target_email},
            "ip_address": None,
            "actor": None,
            "created_at": item.created_at,
        }
        for item in org_activities
    )
    payload.sort(
        key=lambda item: item["created_at"] or datetime.min.replace(tzinfo=UTC),
        reverse=True,
    )
    return cr.success(data={"items": payload[:limit]}, message="Audit logs retrieved")


@protected_router.get("/suppressions", response_model=CustomSuccessResponseSchema)
async def list_suppressions(
    request: Request,
    session: AsyncSessionDep,
    search: str | None = Query(default=None),
    limit: int = Query(default=100, ge=1, le=200),
    offset: int = Query(default=0, ge=0),
):
    context = await load_workspace_context(request, session)
    filters = [
        CampaignSuppressionModel.organization_id == context.organization.id,
        CampaignSuppressionModel.active.is_(True),
    ]
    if search:
        filters.append(
            CampaignSuppressionModel.normalized_email.ilike(f"%{search.strip()}%")
        )
    total = int(
        (
            await session.execute(
                select(func.count(CampaignSuppressionModel.id)).where(*filters)
            )
        ).scalar()
        or 0
    )
    items = (
        (
            await session.execute(
                select(CampaignSuppressionModel)
                .where(*filters)
                .order_by(CampaignSuppressionModel.suppressed_at.desc())
                .limit(limit)
                .offset(offset)
            )
        )
        .scalars()
        .all()
    )
    return cr.success(
        data={
            "items": [
                {
                    "uuid": item.uuid,
                    "email": item.normalized_email,
                    "reason": item.reason,
                    "active": item.active,
                    "suppressed_at": item.suppressed_at,
                    "source_campaign_id": item.source_campaign_id,
                }
                for item in items
            ],
            "total": total,
        },
        message="Suppression list retrieved",
    )


@protected_router.post("/suppressions", response_model=CustomSuccessResponseSchema)
async def add_suppression(
    request: Request,
    body: SuppressionCreateRequest,
    session: AsyncSessionDep,
):
    context = await load_workspace_context(request, session, {"owner", "admin"})
    email = str(body.email).strip().lower()
    item = (
        (
            await session.execute(
                select(CampaignSuppressionModel).where(
                    CampaignSuppressionModel.organization_id == context.organization.id,
                    CampaignSuppressionModel.normalized_email == email,
                )
            )
        )
        .scalars()
        .first()
    )
    now = datetime.now(UTC)
    if not item:
        item = CampaignSuppressionModel(
            organization_id=context.organization.id,
            normalized_email=email,
            reason=body.reason,
            active=True,
            suppressed_at=now,
        )
        session.add(item)
    else:
        item.reason = body.reason
        item.active = True
        item.suppressed_at = now
        item.updated_at = now
    await session.execute(
        text(
            "UPDATE contact_contacts SET subscribed = false, unsubscribed_at = COALESCE(unsubscribed_at, :now), "
            "updated_at = :now WHERE organization_id = :org_id AND lower(email) = :email"
        ),
        {"now": now, "org_id": context.organization.id, "email": email},
    )
    await session.flush()
    await write_audit_log(
        session,
        request,
        action="contacts.suppressed",
        resource_type="suppression",
        resource_uuid=item.uuid,
        metadata={"email": email, "reason": body.reason},
        organization_id=context.organization.id,
    )
    await session.commit()
    return cr.success(
        data={"uuid": item.uuid, "email": email, "reason": item.reason},
        message="Contact suppressed",
    )


@protected_router.delete(
    "/suppressions/{suppression_uuid}", response_model=CustomSuccessResponseSchema
)
async def remove_suppression(
    request: Request,
    suppression_uuid: str,
    session: AsyncSessionDep,
):
    context = await load_workspace_context(request, session, {"owner", "admin"})
    item = (
        (
            await session.execute(
                select(CampaignSuppressionModel).where(
                    CampaignSuppressionModel.uuid == suppression_uuid,
                    CampaignSuppressionModel.organization_id == context.organization.id,
                )
            )
        )
        .scalars()
        .first()
    )
    if not item:
        raise NotFoundError(error="Suppression entry not found")
    item.active = False
    item.updated_at = datetime.now(UTC)
    await write_audit_log(
        session,
        request,
        action="contacts.unsuppressed",
        resource_type="suppression",
        resource_uuid=item.uuid,
        metadata={"email": item.normalized_email},
        organization_id=context.organization.id,
    )
    await session.commit()
    return cr.success(
        data={"uuid": item.uuid, "active": False}, message="Suppression removed"
    )


@public_router.get("/unsubscribe", response_class=HTMLResponse)
async def one_click_unsubscribe(token: str, session: AsyncSessionDep):
    payload = read_unsubscribe_token(token)
    organization_id = int(payload["organization_id"])
    email = str(payload["email"]).lower()
    existing = (
        (
            await session.execute(
                select(CampaignSuppressionModel).where(
                    CampaignSuppressionModel.organization_id == organization_id,
                    CampaignSuppressionModel.normalized_email == email,
                )
            )
        )
        .scalars()
        .first()
    )
    now = datetime.now(UTC)
    if existing:
        existing.active = True
        existing.reason = "unsubscribed"
        existing.suppressed_at = now
        existing.updated_at = now
    else:
        session.add(
            CampaignSuppressionModel(
                organization_id=organization_id,
                normalized_email=email,
                reason="unsubscribed",
                active=True,
                suppressed_at=now,
            )
        )
    await session.execute(
        text(
            "UPDATE contact_contacts SET subscribed = false, unsubscribed_at = COALESCE(unsubscribed_at, :now), "
            "updated_at = :now WHERE organization_id = :org_id AND lower(email) = :email"
        ),
        {"now": now, "org_id": organization_id, "email": email},
    )
    await session.commit()
    return HTMLResponse(
        "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width'>"
        "<title>Unsubscribed</title></head><body style='font-family:system-ui;background:#fbfaf6;padding:48px'>"
        "<main style='max-width:560px;margin:auto;background:white;padding:32px;border-radius:20px;border:1px solid #e6dec7'>"
        "<h1 style='margin-top:0'>You are unsubscribed</h1>"
        "<p>This email address will no longer receive MailTracko campaigns from this sender.</p>"
        "</main></body></html>"
    )


router.include_router(public_router)
router.include_router(protected_router)
